{
  "name": "test-generator-agents",
  "version": "0.1.0",
  "description": "Three-agent pipeline that transforms TMS test cases into working Playwright scripts",
  "main": "orchestrator/pipeline.js",
  "scripts": {
    "enrich": "node agents/enricher/index.js",
    "generate": "node agents/generator/index.js",
    "run-test": "node agents/runner/index.js",
    "pipeline": "node orchestrator/pipeline.js",
    "pipeline:generate-only": "node orchestrator/pipeline.js --skip-run",
    "example:generate": "node agents/generator/index.js --input examples/enriched-case.json"
  },
  "keywords": [
    "playwright",
    "kiwi-tcms",
    "test-automation",
    "ai-agents",
    "code-generation"
  ],
  "author": "SilkRoad Engineering",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@actions/core": "^1.10.0",
    "@actions/github": "^6.0.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
